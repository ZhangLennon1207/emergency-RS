# Copy this file to .env.agent34 on the GPU host. Never commit real values.
AGENT34_PROJECT_ROOT=/path/to/emergency-RS
AGENT34_PYTHON_BIN=/path/to/python
AGENT34_RUNTIME_MODE=real
AGENT34_SHARED_TOKEN=replace-on-server-only
AGENT34_WORK_ROOT=/path/to/private/request-work
AGENT34_PID_FILE=/path/to/private/agent34_service.pid
AGENT34_LOG_FILE=/path/to/private/agent34_service.log

AGENT3_BASE_MODEL=/path/to/agent3-base-model
AGENT3_ADAPTER=/path/to/agent3-v5.2-lora
AGENT3_MODEL_VERSION=Agent3-V5.2
AGENT3_LOAD_IN_4BIT=1
AGENT4_BASE_MODEL=/path/to/agent4-base-model
AGENT4_ADAPTER=/path/to/agent4-v3-lora
