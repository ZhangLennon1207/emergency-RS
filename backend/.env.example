# FastAPI runtime (SQLite, logs and job artifacts; directory is Git-ignored)
EMERGENCY_RS_RUNTIME_ROOT=backend/runtime
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=26214400
MAX_IMAGE_PIXELS=100000000
QUEUE_POLL_SECONDS=0.5

# Agent1: either provide one JSON object or the individual adapter variables.
AGENT1_CONFIG_JSON={"device":"cuda","model_paths":{"building":"models/building_unet_medium_best.pth","damage":"models/damage_unet_7ch_best.pth","road_binary":"models/road_unet_best.pth","road_status":"models/road_status_attresunet7ch_best.pth"}}
AGENT1_DEVICE=cuda
AGENT1_BUILDING_MODEL_PATH=models/building_unet_medium_best.pth
AGENT1_DAMAGE_MODEL_PATH=models/damage_unet_7ch_best.pth
AGENT1_ROAD_BINARY_MODEL_PATH=models/road_unet_best.pth
AGENT1_ROAD_STATUS_MODEL_PATH=models/road_status_attresunet7ch_best.pth

# Agent2 model, LoRA and offload directories remain local and Git-ignored.
AGENT2_CONFIG_JSON={"base_model_path":"models/Qwen2.5-VL-7B-Instruct","lora_path":"models/agent2-lora","gpu_memory":"6GiB","cpu_memory":"24GiB"}
AGENT2_BASE_MODEL_PATH=models/Qwen2.5-VL-7B-Instruct
AGENT2_LORA_PATH=models/agent2-lora
AGENT2_OFFLOAD_DIR=backend/runtime/model_offload

# Agent3/4 are intentionally not configured in this integration version.
